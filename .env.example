# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave privada do Supabase: nunca use NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY

# Segredo usado para assinar a sessão do chat (mínimo 32 caracteres)
CHAT_SESSION_SECRET=gere-um-segredo-com-pelo-menos-32-caracteres

# Segredo compartilhado entre n8n e Next.js
N8N_WEBHOOK_SECRET=seu-segredo-do-n8n

# Configuração existente do projeto
N8N_WEBHOOK_URL=https://seu-n8n.example.com/webhook/seu-webhook
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEBHOOK_URL=http://localhost:3000/api/webhook/n8n
NEXT_PUBLIC_NAME=AutoChat
